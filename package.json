{
  "name": "dsh-pulse",
  "version": "0.1.1",
  "description": "本机脉象（dsh-pulse）：把压缩判级、四道机械闸、未提交改动三件纪律做成 DSH 统计条上的一格常驻读数，点一下按配置跑命令集并把报告落成 md + json；一个数一条线，不用再记着去跑脚本。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "pulse",
    "compaction",
    "discipline"
  ]
}
